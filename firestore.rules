rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    match /usernameLookup/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read is required for the no-login student home.
    match /users/{uid} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']));
      allow delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    // Keep status private; this feature is no longer shown on student view.
    match /activityStatus/{statusId} {
      allow read: if isAuth() && resource.data.studentUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isAuth() &&
        resource.data.studentUid == request.auth.uid &&
        request.resource.data.studentUid == request.auth.uid;
      allow delete: if isAuth() && resource.data.studentUid == request.auth.uid;
    }
  }
}
