rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Activity attachments
    match /activities/{activityId}/{fileName} {
      // All authenticated users can download attachments
      allow read: if request.auth != null;
      // Only admins can upload / delete attachments
      allow write: if request.auth != null &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'ADMIN';
    }
  }
}
